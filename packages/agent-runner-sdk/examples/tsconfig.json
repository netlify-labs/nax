{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [],
    "useUnknownInCatchVariables": true
  },
  "include": [
    "*.ts"
  ]
}
