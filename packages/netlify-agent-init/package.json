{
  "name": "netlify-agent-init",
  "version": "0.1.0",
  "description": "Set up tools, agent skills, repositories and checks inside Netlify Agent Runners from a postinstall hook. Does nothing anywhere else.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.17"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/netlify-labs/nax.git",
    "directory": "packages/netlify-agent-init"
  },
  "keywords": [
    "netlify",
    "agent-runner",
    "agents",
    "skills",
    "postinstall"
  ],
  "bin": {
    "netlify-agent-init": "bin/netlify-agent-init.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.js",
    "pack:smoke": "node scripts/pack-smoke.js",
    "ci": "npm run typecheck && npm run test && npm run pack:smoke",
    "prepublishOnly": "npm run ci",
    "test:ffmpeg": "node scripts/ffmpeg-smoke.js"
  }
}
